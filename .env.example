# ---------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------

# --- app ---
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=4200

# --- security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-this-placeholder-is-exactly-long-enough-to-boot
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# --- database ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trading
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- execution ---
# sim | alpaca_paper   (phase 00 ships neither adapter yet; sim lands in phase 02)
BROKER=sim
# Global safety rail. Nothing in this repo may ever place a live order.
ALLOW_LIVE_TRADING=false

# --- phase 07+ : telegram (leave blank until then) ---
TELEGRAM_BOT_TOKEN=

# --- phase 08+ : llm (leave as-is until then) ---
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b-instruct

# --- phase 10+ : alpaca paper (leave blank until then) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
